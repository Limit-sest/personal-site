---
import Layout from "../layouts/Layout.astro";
---

<Layout
  header="O mně"
  lang="cs"
  description="Tonda Kučera - programátor, grafik a kreativec."
  isHome={true}
>
  <section class="space-y-3 text-xl">
    <h2 class="font-display text-accent mb-2 text-4xl font-bold">ahoj!</h2>
    <p>
      <span class="text-accent"
        >já jsem Tonda. Student, lezec, programátor a umělec.</span
      >
    </p>
    <p>
      Aktuálně studuju na <a href="https://ssps.cz/">Smíchovské střední</a> a jsem
      spoluzakladatelem studentského startupu <a href="https://intstudio.cz"
        >Integer studio</a
      >, kde vyvíjíme interní aplikace pro firmy. Pracujeme na něm s kamarády už
      od roku 2025.
    </p>
    <p>
      Ve školním roce 2025/26 jsem učil informatiku na <a
        href="https://www.skolapoznavani.cz/">ZŠ Poznávání</a
      >, kde jsem děti seznamoval s programováním, bezpečným pohybem na
      internetu a jak technologie prakticky fungují.
    </p>
    <p>
      Když mám čas, rád <a href="/photos">fotím</a> a hraju si s kompozicí, tvořím
      elektronickou hudbu nebo designuju
      <a href="/graphics">grafiku</a>.
    </p>
  </section>
  <section class="text-xl">
    <h2 class="font-display text-accent mb-2">Můžeš mě najít na...</h2>
    <address>
      <ul role="list" class="star space-y-2">
        <li>
          GitHubu, jako <a
            href="https://github.com/Limit-sest"
            class="text-accent underline"
            target="_blank">@Limit-sest</a
          >
        </li>
        <li>
          Discordu, jako <button
            type="button"
            class="text-accent copy inline cursor-pointer"
            data-copy="@limit6"
          >
            @limit6<img
              src="/icons/copy.png"
              alt="Kopírovat"
              class="pixelated ml-1 inline h-6 w-6 align-text-top"
            />
          </button>
        </li>
        <li>
          Nebo mi napiš email na <button
            type="button"
            class="text-accent copy inline cursor-pointer"
            data-copy="tonda@kucera.dev"
          >
            tonda@kucera.dev<img
              src="/icons/copy.png"
              alt="Kopírovat"
              class="pixelated ml-1 inline h-6 w-6 align-text-top"
            />
          </button>
        </li>
      </ul>
    </address>
  </section>
  <section class="text-xl">
    <h2 class="font-display text-accent mb-2">Zajímaví lidé a projekty</h2>
    <ul role="list" class="star space-y-2">
      <li>
        <a
          href="https://www.youtube.com/@ouut_heere"
          class="text-accent underline"
          target="_blank">out here.</a
        >
      </li>
      <li>
        <a
          href="https://www.youtube.com/@MakeWithMiles"
          class="text-accent underline"
          target="_blank">Make with miles</a
        >
      </li>
      <li>
        <a
          href="https://podcastdira.cz/"
          class="text-accent underline"
          target="_blank">Podcast Díra</a
        >
      </li>
      <li>
        <a
          href="https://www.instagram.com/_upground_/"
          class="text-accent underline"
          target="_blank">Upground</a
        >
      </li>
    </ul>
  </section>
</Layout>

<style>
  ul.star {
    list-style-type: "✳";
  }
  ul {
    list-style-position: outside;
    margin-left: 1.5rem;
  }
  li {
    padding-left: 12px;
  }
  address {
    margin: 0;
    padding: 0;
    font-style: normal;
  }

  section {
    margin-bottom: calc(var(--spacing) * 8);
  }
</style>

<style is:inline>
  .copy img {
    filter: invert(11%) sepia(74%) saturate(5852%) hue-rotate(229deg)
      brightness(99%) contrast(110%);
  }

  .dark .copy img {
    filter: invert(40%) sepia(69%) saturate(3315%) hue-rotate(210deg)
      brightness(102%) contrast(100%);
  }
</style>

<script>
  const copyElements = document.querySelectorAll(".copy");

  async function handleClick(event: Event) {
    const clickedElement = event.currentTarget as Element;
    const data = clickedElement.getAttribute("data-copy");
    if (!data) return;
    await navigator.clipboard.writeText(data);
    const img = clickedElement.querySelector("img");
    if (img) {
      img.src = "/icons/check.png";
      setTimeout(() => {
        img.src = "/icons/copy.png";
      }, 3000);
    }
  }

  copyElements.forEach((e) => {
    e.addEventListener("click", handleClick);
  });
</script>
